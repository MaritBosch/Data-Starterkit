# Multi-stage build: dependencies bouwen in een 'builder'-laag, alleen het resultaat
# meenemen naar de kleine runtime-laag. Vergelijk de uiteindelijke image-grootte met
# een single-stage versie om het verschil te zien (docker images).

# --- Stage 1: builder ---
FROM python:3.11-slim AS builder

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# --- Stage 2: runtime ---
FROM python:3.11-slim AS runtime

WORKDIR /app
COPY --from=builder /root/.local /root/.local
COPY . .

ENV PATH=/root/.local/bin:$PATH
EXPOSE 8080

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
